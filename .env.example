# =============================================================================
# CodeSentinel — Environment Variables (Example / Template)
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# --- LLM: Groq ---
GROQ_API_KEY=                              # Get from: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# --- GitHub Integration ---
GITHUB_TOKEN=                              # Fine-grained PAT: https://github.com/settings/tokens?type=beta
                                           # Required permissions: pull_requests:write, contents:read, metadata:read
GITHUB_WEBHOOK_SECRET=                     # Generate: python -c "import secrets; print(secrets.token_hex(32))"

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=

# --- Rate Limiting ---
WEBHOOK_RATE_LIMIT=100/minute

# --- Review Thresholds ---
CRITIC_CONFIDENCE_THRESHOLD=0.6
MAX_FINDINGS_PER_REVIEW=50

# --- Optional: LangSmith tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=codesentinel
